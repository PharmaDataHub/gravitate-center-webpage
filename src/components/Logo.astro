---
/*
 * Wordmark: a small "focus" mark (concentric rings drawing toward a centre point)
 * beside the name. Provisional until an approved logo exists (see CONTENT_REVIEW.md).
 */
interface Props {
  inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<span class:list={['logo', { 'logo--inverse': inverse }]}>
  <svg class="logo__mark" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false">
    <circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.45"></circle>
    <circle cx="16" cy="16" r="9.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <circle cx="16" cy="16" r="4" class="logo__core"></circle>
    <circle cx="27.6" cy="7.4" r="2.6" class="logo__core"></circle>
  </svg>
  <span class="logo__text">Gravitate</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--blue-deep);
  }

  .logo--inverse {
    color: var(--white);
  }

  .logo__mark {
    width: 2rem;
    height: 2rem;
    flex: none;
  }

  .logo__core {
    fill: var(--amber);
  }

  .logo__text {
    font-family: var(--font-display-stack);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
  }
</style>
