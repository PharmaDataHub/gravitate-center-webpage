---
/*
 * Logo: the Gravitate Center mark beside the name.
 *
 * TEMPORARY: the mark is a raster cut-out from the slide template background
 * (src/assets/brand/logo-mark.png, an alpha mask), tinted with CSS so one file
 * serves both the blue and the white (inverse) versions. Replace it with the
 * official SVG logo when it is available.
 */
import mark from '../assets/brand/logo-mark.png';

interface Props {
  inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<span class:list={['logo', { 'logo--inverse': inverse }]}>
  <span class="logo__mark" style={`--logo-mark: url(${mark.src})`} aria-hidden="true"></span>
  <span class="logo__text">Gravitate Center</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--blue-deep);
  }

  .logo--inverse {
    color: var(--white);
  }

  .logo__mark {
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    background: var(--blue-brand);
    mask: var(--logo-mark) center / contain no-repeat;
  }

  .logo--inverse .logo__mark {
    background: var(--white);
  }

  @media (forced-colors: active) {
    .logo__mark {
      forced-color-adjust: none;
      background: CanvasText;
    }
  }

  .logo__text {
    font-family: var(--font-display-stack);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  @media (max-width: 30em) {
    .logo__mark {
      width: 2rem;
      height: 2rem;
    }

    .logo__text {
      font-size: 1.3rem;
    }
  }
</style>
