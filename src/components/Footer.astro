---
import Logo from './Logo.astro';
import { footerNav, legacy, site } from '../config/site';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__about">
      <a href={url('/')} class="site-footer__brand" aria-label="Gravitate Center home">
        <Logo inverse />
      </a>
      <p class="site-footer__name">{site.fullName}</p>
      <p>{site.tagline}</p>
      <p class="site-footer__legacy">
        Building on the work of the <a href={legacy.url}>{legacy.name}</a> project ({legacy.period}).
      </p>
    </div>

    <nav aria-label="Footer">
      <h2 class="site-footer__heading">Explore</h2>
      <ul role="list">
        {footerNav.map((item) => (
          <li>
            <a href={url(item.href)}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="site-footer__heading">Work with us</h2>
      <p>Patient groups, clinicians, researchers, the pharmaceutical industry and standards bodies are all welcome.</p>
      <a class="button button--accent" href={url('/collaborate/')}>
        Explore a partnership
      </a>
    </div>
  </div>

  <div class="container site-footer__base">
    <p>© {year} {site.name}</p>
    <p>No cookies. No tracking.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--blue-deep);
    color: var(--text-on-dark);
    padding-top: var(--space-2xl);
    font-size: var(--step--1);
  }

  .site-footer a:not(.button) {
    color: var(--white);
  }

  .site-footer a:not(.button):hover {
    color: var(--orange);
  }

  .site-footer :focus-visible {
    outline-color: var(--orange);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: 1fr;
  }

  @media (min-width: 48em) {
    .site-footer__grid {
      grid-template-columns: 1.4fr 1fr 1.2fr;
    }
  }

  .site-footer__brand {
    display: inline-flex;
    margin-bottom: var(--space-m);
    text-decoration: none;
  }

  .site-footer__about p {
    max-width: 26rem;
  }

  .site-footer__name {
    font-weight: 600;
  }

  .site-footer__legacy {
    color: var(--text-on-dark-muted);
  }

  .site-footer__heading {
    font-family: var(--font-body-stack);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-on-dark-muted);
    margin-bottom: var(--space-s);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
  }

  li a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    text-decoration: none;
  }

  li a:hover {
    text-decoration: underline;
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-l);
    margin-top: var(--space-xl);
    padding-block: var(--space-m);
    border-top: 1px solid var(--blue-deep-80);
    color: var(--text-on-dark-muted);
  }

  .site-footer__base p {
    margin: 0;
  }
</style>
