---
import Logo from './Logo.astro';
import { mainNav } from '../config/site';
import { isCurrent, url } from '../lib/url';

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={url('/')} aria-label="Gravitate Center home">
      <Logo />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      hidden
    >
      <span class="menu-toggle__icon" aria-hidden="true"><span></span></span>
      <span class="menu-toggle__label">Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul role="list">
        {
          mainNav.map((item) => {
            const current = isCurrent(item.href, pathname);
            const exact = url(item.href) === pathname;
            return (
              <li>
                <a
                  href={url(item.href)}
                  aria-current={exact ? 'page' : current ? 'true' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
      <a class="button button--accent site-nav__cta" href={url('/collaborate/')}>
        Explore a partnership
      </a>
    </nav>
  </div>
</header>

<script>
  // Progressive enhancement: without JavaScript the navigation is always visible.
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = header?.querySelector<HTMLElement>('#site-nav');

  if (header && toggle && nav) {
    const mq = window.matchMedia('(max-width: 56.24em)');
    header.classList.add('js-menu');
    toggle.hidden = false;

    const setOpen = (open: boolean, returnFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-open', open);
      document.body.classList.toggle('menu-open', open);
      if (!open && returnFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
      if (open) nav.querySelector<HTMLElement>('a')?.focus();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('is-open')) setOpen(false, true);
    });

    // Close when focus leaves the menu (e.g. tabbing past the last link).
    header.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (mq.matches && next && !header.contains(next)) setOpen(false);
    });

    mq.addEventListener('change', () => setOpen(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--blue-line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: var(--header-height);
  }

  .site-header__brand {
    display: inline-flex;
    padding-block: var(--space-xs);
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-l);
  }

  .site-nav ul {
    display: flex;
    gap: var(--space-l);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav ul a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--blue-deep);
    font-weight: 550;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  .site-nav ul a:hover {
    border-bottom-color: var(--blue);
  }

  .site-nav ul a[aria-current] {
    border-bottom-color: var(--orange-dark);
  }

  .site-nav__cta {
    min-height: 2.75rem;
    padding-block: 0.55rem;
  }

  .menu-toggle {
    display: none;
  }

  /* ---------- Small screens ---------- */
  @media (max-width: 56.24em) {
    .site-header__inner {
      flex-wrap: wrap;
    }

    /* No-JS fallback: links wrap onto a second row. */
    .site-nav {
      width: 100%;
      flex-wrap: wrap;
      gap: var(--space-s);
      padding-bottom: var(--space-s);
    }

    .site-nav ul {
      flex-wrap: wrap;
      gap: 0 var(--space-m);
    }

    .site-nav__cta {
      display: none;
    }

    /* With JS: a deliberate full-width disclosure panel. */
    .js-menu .menu-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 2.75rem;
      padding: 0 0.9rem;
      border: 2px solid var(--blue-deep);
      border-radius: var(--radius);
      background: var(--white);
      color: var(--blue-deep);
      font: inherit;
      font-weight: 650;
      cursor: pointer;
    }

    .menu-toggle__icon {
      position: relative;
      width: 1.1rem;
      height: 0.8rem;
    }

    .menu-toggle__icon::before,
    .menu-toggle__icon::after,
    .menu-toggle__icon span {
      content: '';
      position: absolute;
      left: 0;
      width: 100%;
      height: 2px;
      background: currentColor;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .menu-toggle__icon::before {
      top: 0;
    }

    .menu-toggle__icon span {
      top: calc(50% - 1px);
    }

    .menu-toggle__icon::after {
      bottom: 0;
    }

    .is-open .menu-toggle__icon::before {
      transform: translateY(0.35rem) rotate(45deg);
    }

    .is-open .menu-toggle__icon span {
      opacity: 0;
    }

    .is-open .menu-toggle__icon::after {
      transform: translateY(-0.35rem) rotate(-45deg);
    }

    .js-menu .site-nav {
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-l);
      padding: var(--space-s) 0 var(--space-l);
    }

    .js-menu.is-open .site-nav {
      display: flex;
    }

    .js-menu .site-nav ul {
      flex-direction: column;
      gap: 0;
    }

    .js-menu .site-nav ul li {
      border-top: 1px solid var(--blue-line);
    }

    .js-menu .site-nav ul a {
      display: flex;
      width: 100%;
      min-height: 3.25rem;
      font-family: var(--font-display-stack);
      font-size: var(--step-2);
      font-weight: 500;
      border-bottom: 0;
    }

    .js-menu .site-nav ul a[aria-current]::before {
      content: '';
      width: 4px;
      align-self: stretch;
      margin: 0.7rem 0.75rem 0.7rem 0;
      background: var(--orange);
    }

    .js-menu .site-nav__cta {
      display: inline-flex;
    }
  }
</style>
