---
/*
 * Describes only what this website technically does. It is not a legal privacy
 * policy: the responsible organisation and its contact details are not yet
 * confirmed (see CONTENT_REVIEW.md).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { contact } from '../config/site';
---

<BaseLayout
  title="Privacy"
  description="How the Gravitate website handles your information: no cookies, no analytics and no forms."
>
  <PageHeader
    eyebrow="Privacy"
    title="How this website handles your information"
    lede="A plain description of what this website does, and does not do, with information about visitors."
  />

  <section class="section">
    <div class="container prose">
      <h2>What this website does not do</h2>
      <ul>
        <li>It does not set cookies.</li>
        <li>It does not use analytics, advertising or tracking scripts.</li>
        <li>It does not load fonts, scripts or images from third-party services while you browse. Fonts are served from this website.</li>
        <li>It has no forms and does not collect or store personal information.</li>
      </ul>

      <h2>Hosting</h2>
      <p>
        This website is a set of static pages hosted on
        <a href="https://docs.github.com/en/pages">GitHub Pages</a>. As with any web host, GitHub
        receives technical information such as your IP address when your browser requests a page,
        in order to deliver it and keep the service secure. See the
        <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">GitHub General Privacy Statement</a>
        for details.
      </p>

      <h2>Links to other websites</h2>
      <p>
        Some pages link to other websites, such as the Gravitate-Health project website. Those
        websites have their own privacy practices, which apply when you visit them.
      </p>

      {
        contact.email && (
          <>
            <h2>If you email us</h2>
            <p>
              Email links on this website open your own email program. If you write to{' '}
              <a href={`mailto:${contact.email}`}>{contact.email}</a>, we receive the information you
              choose to include and use it only to reply to you.
            </p>
          </>
        )
      }

      <h2>Changes</h2>
      <p>
        If the way this website works changes, for example if we add a contact form or a
        newsletter, we will update this page first.
      </p>
    </div>
  </section>
</BaseLayout>
