---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { absoluteUrl, url } from '../lib/url';

interface Props {
  /** Page title without the site suffix. Omit on the home page. */
  title?: string;
  description?: string;
  /** Absolute or site-relative URL of a social sharing image. */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  /** Extra JSON-LD objects; only include verified facts. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const fullTitle = title ? `${title} · ${site.titleSuffix}` : `${site.fullName} · ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = image
  ? new URL(image, Astro.site).href
  : absoluteUrl('/social-card.png', Astro.site);

const baseJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.fullName,
  alternateName: site.name,
  url: absoluteUrl('/', Astro.site),
  inLanguage: site.locale,
};
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} updates`}
      href={url('/rss.xml')}
    />
    <meta name="theme-color" content="#08263A" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.ogLocale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-display" preload={[{ weight: 500, style: 'normal' }]} />
    <Font cssVariable="--font-body" preload={[{ weight: 400, style: 'normal' }]} />

    {
      [baseJsonLd, ...jsonLd].map((data) => (
        <script type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-s);
    top: var(--space-s);
    z-index: 100;
    padding: var(--space-s) var(--space-m);
    background: var(--orange);
    color: var(--blue-deep);
    font-weight: 700;
    border-radius: var(--radius);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
    outline: 3px solid var(--blue-deep);
  }

  main:focus {
    outline: none;
  }
</style>
